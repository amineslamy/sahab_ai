# GraphMem Go - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Providers (at least one required for full functionality)
# =============================================================================

# OpenAI - Primary LLM provider
OPENAI_API_KEY=sk-your-openai-api-key-here

# Azure OpenAI (optional)
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Ollama (optional - for local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenRouter (optional - multi-model gateway)
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Together AI (optional)
TOGETHER_API_KEY=your-together-api-key-here

# Groq (optional - fast inference)
GROQ_API_KEY=gsk_your-groq-key-here

# =============================================================================
# Embedding Providers (at least one required for semantic search)
# =============================================================================

# OpenAI Embeddings - Uses OPENAI_API_KEY above
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# Storage Backends (optional - defaults to in-memory)
# =============================================================================

# Neo4j (optional - for persistent graph storage)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Turso/LibSQL (optional - for SQLite-based storage)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# Or use local file:
TURSO_LOCAL_PATH=./graphmem.db

# =============================================================================
# Test Configuration
# =============================================================================

# Set to "true" to run integration tests that require external services
RUN_INTEGRATION_TESTS=false

# Set to "true" to run tests that require LLM API calls (costs money)
RUN_LLM_TESTS=false

# Set to "true" to run tests that require Neo4j
RUN_NEO4J_TESTS=false

# Set to "true" to run tests that require Redis  
RUN_REDIS_TESTS=false

# Set to "true" to run tests that require Turso
RUN_TURSO_TESTS=false


