# GraphMem-Go Docker Environment Configuration
# Copy this file to .env and customize for your setup
#
# This file supports TWO modes:
#   1. LOCAL MODE:  Use containerized services (Neo4j, Redis, LibSQL)
#   2. HOSTED MODE: Use external/hosted services (Turso Cloud, Redis Cloud, Neo4j Aura)
#
# =============================================================================
# MODE SELECTION
# =============================================================================

# Set to "true" to use local containerized services
# Set to "false" to use hosted services (configure URLs below)
USE_LOCAL_SERVICES=true

# =============================================================================
# LLM API KEYS (Required for full functionality)
# At least one LLM provider is needed for knowledge extraction
# =============================================================================

# OpenAI - Primary LLM provider (recommended)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Azure OpenAI (alternative to OpenAI)
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Anthropic Claude (optional)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# OpenRouter - Multi-model gateway (optional)
# OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Together AI (optional)
# TOGETHER_API_KEY=your-together-api-key

# Groq - Fast inference (optional)
# GROQ_API_KEY=gsk_your-groq-key-here

# =============================================================================
# LOCAL SERVICES CONFIGURATION (when USE_LOCAL_SERVICES=true)
# These are used by docker-compose for the containerized services
# =============================================================================

# Neo4j local container settings
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphmem_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Redis local container settings  
REDIS_PORT=6379
REDIS_PASSWORD=

# LibSQL local container settings
LIBSQL_PORT=8080
LIBSQL_GRPC_PORT=5001

# Ollama local container settings (for local LLM)
OLLAMA_PORT=11434

# Application port
APP_PORT=8081

# =============================================================================
# HOSTED SERVICES CONFIGURATION (when USE_LOCAL_SERVICES=false)
# Uncomment and configure these to use external hosted services
# =============================================================================

# Neo4j Aura or self-hosted
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-aura-password

# Redis Cloud or self-hosted
# REDIS_URL=redis://user:password@your-redis-host.redis-cloud.com:16379

# Turso Cloud
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# =============================================================================
# TEST CONFIGURATION
# Controls which integration tests are run
# =============================================================================

# Master switch for integration tests
RUN_INTEGRATION_TESTS=true

# Enable/disable specific test suites
# Set to "true" to run tests that make LLM API calls (costs money!)
RUN_LLM_TESTS=false

# Storage backend tests (enabled by default when using local services)
RUN_NEO4J_TESTS=true
RUN_REDIS_TESTS=true
RUN_TURSO_TESTS=true

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Embedding model (uses OpenAI by default)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# GraphMem-specific settings
# GRAPHMEM_LLM_PROVIDER=openai
# GRAPHMEM_LLM_MODEL=gpt-4o-mini
# GRAPHMEM_EMBEDDING_PROVIDER=openai
# GRAPHMEM_DECAY_HALF_LIFE_DAYS=30
# GRAPHMEM_CONSOLIDATION_THRESHOLD=0.85

